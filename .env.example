# Supabase: Project Settings > API. Never expose service role key in browser code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Stripe: API keys + recurring Price IDs. Configure webhook endpoint /api/stripe/webhook.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_STARTER=price_replace_me
STRIPE_PRICE_ENTREPRISE=price_replace_me
# TikTok for Developers: Login Kit app credentials.
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=http://localhost:4173/auth/tiktok/callback
PORT=4173
APP_URL=http://localhost:4173/app
NODE_ENV=development
